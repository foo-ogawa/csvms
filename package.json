{
  "name": "@csvms/monorepo",
  "private": true,
  "version": "0.9.7",
  "description": "CSVMS - Edit CSV files with a CMS-like UI",
  "author": "foo-ogawa",
  "license": "MIT",
  "homepage": "https://github.com/foo-ogawa/csvms#readme",
  "bugs": {
    "url": "https://github.com/foo-ogawa/csvms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foo-ogawa/csvms.git"
  },
  "workspaces": [
    "server",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:all": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build:frontend && npm run build:server",
    "build:frontend": "npm run build --workspace=frontend",
    "build:server": "npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "test": "npm run test --workspace=server",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=frontend",
    "clean": "rm -rf server/dist frontend/dist"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

