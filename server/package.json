{
  "name": "@csvms/cli",
  "version": "0.9.0",
  "description": "CSVMS - Edit CSV files with a CMS-like UI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "csvms": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "csv",
    "cms",
    "editor",
    "git",
    "data",
    "spreadsheet",
    "admin"
  ],
  "author": "foo-ogawa",
  "license": "MIT",
  "homepage": "https://github.com/foo-ogawa/csvms#readme",
  "bugs": {
    "url": "https://github.com/foo-ogawa/csvms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foo-ogawa/csvms.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "express": "^4.21.0",
    "expr-eval": "^2.0.2",
    "fast-glob": "^3.3.2",
    "get-port": "^7.1.0",
    "open": "^10.1.0",
    "papaparse": "^5.4.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/papaparse": "^5.3.15",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module"
}
